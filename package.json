    "url": "https://github.com/dmitry-dmt/codex-hop/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmitry-dmt/codex-hop.git"
  },
  "license": "MIT",
  "main": "src/router.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "start": "node src/router.js",
    "test": "node --test test/*.test.js"
  },
  "files": [
    "src/",
    "examples/",
    "scripts/",
    "README.md",
    "SECURITY.md",
    "LICENSE"
